{
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/((?!api/|sitemap\\.xml$|robots\\.txt$|static/|images/|photo-roll/|project-previews/|favicon\\.ico$|manifest\\.json$|logo192\\.png$|logo512\\.png$|AndiScarola_Resume\\.pdf$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "andiscarola.vercel.app"
        }
      ],
      "destination": "https://andiscarola.com/:path*",
      "permanent": true
    }
  ]
}
